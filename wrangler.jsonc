{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ogshot",
  "main": "src/index.js",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  // Serialized page functions break when esbuild injects __name helpers.
  "keep_names": false,
  "observability": { "enabled": true },
  // Variables set in the dashboard survive deploys. The `vars` below only seed the first one.
  "keep_vars": true,
  "browser": { "binding": "BROWSER", "remote": true },
  "vars": {
    // Comma-separated. Exact hosts, or "*.example.com" for any subdomain. Replace with yours.
    "ALLOWED_HOSTS": "example.com,*.example.com"
  }
}
