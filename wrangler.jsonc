{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ogshot",
  "main": "src/index.js",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  // Serialized page functions break when esbuild injects __name helpers.
  "keep_names": false,
  "observability": { "enabled": true },
  "browser": { "binding": "BROWSER", "remote": true },
  // ALLOWED_HOSTS is set in the dashboard, not here. keep_vars makes deploys leave it alone,
  // which only works for variables this file doesn't define.
  "keep_vars": true
}
