{
  "name": "ogshot",
  "version": "0.1.0",
  "description": "Open Graph images from your own HTML and CSS, rendered and cached on Cloudflare Workers.",
  "keywords": [
    "open-graph",
    "og-image",
    "cloudflare-workers",
    "browser-rendering"
  ],
  "license": "MIT",
  "author": "Jarrett Lusso",
  "repository": "github:jclusso/ogshot",
  "homepage": "https://github.com/jclusso/ogshot#readme",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/client/index.d.ts",
      "default": "./dist/client/index.js"
    }
  },
  "files": [
    "dist/client/index.js",
    "dist/client/index.d.ts"
  ],
  "sideEffects": false,
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "build:client": "node scripts/build-client.js",
    "build:pages": "node scripts/build-pages.js",
    "pretest": "node scripts/build-client.js",
    "test": "vitest run",
    "prepack": "node scripts/build-client.js"
  },
  "devDependencies": {
    "@cloudflare/puppeteer": "^1.4.0",
    "@cloudflare/vitest-plugin": "^1.1.4",
    "esbuild": "^0.28.2",
    "fflate": "^0.8.3",
    "vitest": "^4.1.0",
    "wrangler": "^4.129.0"
  }
}
